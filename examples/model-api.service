[Unit]
Description=Model inference API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=model-api
Group=model-api
WorkingDirectory=/srv/model-api
EnvironmentFile=/etc/model-api/runtime.env
ExecStartPre=/srv/model-api/venv/bin/python /srv/model-api/deployment/scripts/verify_artifact.py
ExecStart=/srv/model-api/venv/bin/uvicorn ${MODEL_APP_MODULE} --host 127.0.0.1 --port 8000 --workers 1 --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=on-failure
RestartSec=5
TimeoutStartSec=180
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadOnlyPaths=/srv/model-api/private
UMask=027

[Install]
WantedBy=multi-user.target
